@article{singh_workload-driven_2025,
	title = {Workload-{Driven} {Perspectives} on {Networked} {Filesystems}: {Benchmarking} {NFS}/{SMB} and {Version}-{Level} {Trade}-offs},
	volume = {3},
	copyright = {Copyright (c) 2025 International Journal of Advanced Research and Interdisciplinary Scientific Endeavours},
	issn = {3048-7021},
	shorttitle = {Workload-{Driven} {Perspectives} on {Networked} {Filesystems}},
	url = {https://www.ijarise.org/index.php/ijarise/article/view/140},
	doi = {10.61359/11.2206-2553},
	abstract = {This paper surveys network file system protocols with a systems focus on NFS and SMB/CIFS, explaining how transparency to applications interacts with protocol design, client caching, and failure handling in distributed storage stacks. It consolidates measurement methodology via widely used tools (Postmark for small-file, mail-server-like workloads and LADDIS/SPEC SFS for NFS server micro-operations), detailing metrics, load generation, and interpretability limits across client/server configurations. A versioned protocol comparison highlights, when NFSv4.1’s stateful features and read delegations reduce request volume and improve throughput over NFSv3 for small-file access patterns, while also identifying workloads where added chattiness can degrade performance. Complementary production CIFS trace analysis quantifies real-world I/O volumes, read-write ratios, reopen distributions, and low sharing rates, yielding design implications for client-side caching, tiering, and write-optimized filesystems. Together, these benchmark-anchored and trace-driven perspectives provide practical guidance for performance evaluation and protocol selection in computer systems and storage research.},
	language = {en},
	number = {4},
	urldate = {2026-04-01},
	journal = {International Journal of Advanced Research and Interdisciplinary Scientific Endeavours},
	author = {Singh, Pankaj},
	month = nov,
	year = {2025},
	keywords = {Benchmarking, Network File Systems, Performance Evaluation, SMB/CIFS},
	pages = {975--981},
	file = {Full Text PDF:files/10/Singh - 2025 - Workload-Driven Perspectives on Networked Filesystems Benchmarking NFSSMB and Version-Level Trade-.pdf:application/pdf},
}

